{
  "identifier": "main",
  "description": "permissions for desktop app",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "dialog:default",
    "dialog:allow-ask",
    "dialog:allow-message",
    "core:event:allow-listen",
    "core:event:default",
    "notification:default",
    "fs:default",
    "global-shortcut:default",
    "global-shortcut:allow-register",
    "opener:allow-open-path",
    "cache:default",
    "clipboard-x:default"
  ]
}