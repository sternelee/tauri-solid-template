{
  "name": "@raycast/plugin-template",
  "version": "1.0.0",
  "description": "Raycast UI component with Shadow DOM support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./shadow-dom": {
      "import": "./dist/shadow-dom.js",
      "require": "./dist/shadow-dom.cjs",
      "types": "./dist/shadow-dom.d.ts"
    },
    "./components": {
      "import": "./dist/components.js",
      "require": "./dist/components.cjs",
      "types": "./dist/components.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "require": "./dist/types.cjs",
      "types": "./dist/types.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./assets/*": "./dist/assets/*"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.js",
    "build:watch": "node scripts/dev.js",
    "dev": "node scripts/dev.js",
    "package": "node scripts/package.js",
    "package:all": "node scripts/package.js --templates basic,forms,advanced,complete",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rimraf dist",
    "clean:packages": "rimraf packages",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "keywords": [
    "raycast",
    "ui-components",
    "shadow-dom",
    "typescript",
    "solid-js",
    "tauri"
  ],
  "author": {
    "name": "Raycast Plugin Developer",
    "email": "developer@raycast.app"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raycast/plugin-components.git"
  },
  "bugs": {
    "url": "https://github.com/raycast/plugin-components/issues"
  },
  "homepage": "https://github.com/raycast/plugin-components#readme",
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.5.0",
    "@tauri-apps/plugin-clipboard-manager": "^1.0.0",
    "@tauri-apps/plugin-fs": "^1.0.0",
    "@tauri-apps/plugin-os": "^1.0.0",
    "@tauri-apps/plugin-notification": "^1.0.0",
    "@tauri-apps/plugin-shell": "^1.0.0",
    "@tauri-apps/plugin-dialog": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "solid-js": "^1.8.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0",
    "vite-plugin-solid": "^2.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [">= 0.25%", "not dead", "not IE 11"],
  "config": {
    "raycast": {
      "componentType": "ui",
      "shadowDOM": true,
      "apiVersion": "1.0.0",
      "supportedPlatforms": ["macos", "windows", "linux"]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}

