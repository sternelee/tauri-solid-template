    };
}

pub fn key_to_char(key: &Key, is_shifted: bool) -> Option<char> {
    match key {
        Key::Backspace => Some('\u{8}'),
        Key::Return | Key::KpReturn => Some('\n'),
        Key::Tab => Some('\t'),
        _ => RDEV_KEY_MAP
            .get(key)
            .map(|(c, s)| if is_shifted { *s } else { *c }),
    }
}
