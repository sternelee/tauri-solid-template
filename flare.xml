	showSettings: vi.fn(),
	_reset: function () {
		this.extensionToSelect = null;
		this.showSettings.mockClear();
	}
}));
vi.mock('$lib/viewManager.svelte', () => ({
	viewManager
}));

const mockAuthor = {
