		pluginTitle: 'Flare',
		pluginName: 'clipboard-history',
		commandName: 'clipboard-history',
		pluginPath: 'builtin:history',
		icon: clipboardHistoryCommandIcon,
		preferences: [],
		mode: 'view',
		owner: 'flare'
	};

	const searchSnippetsPlugin: PluginInfo = {
